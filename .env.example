# Optional: AI help. QuantCompass works fully without any key.
# The key can also be typed in the app (AI help tab) for one session only.
# Copy this file to .env and fill in ONE provider. Never commit .env.
QC_AI_PROVIDER=gemini          # gemini | mistral | anthropic | openai_compatible | ollama
QC_AI_MODEL=                   # empty = default model of the provider
GEMINI_API_KEY=
MISTRAL_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=    # e.g. https://api.openai.com/v1 or your university gateway
OPENAI_COMPATIBLE_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
